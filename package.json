{
  "name": "make-shared-state-hook",
  "version": "1.3.0",
  "description": "Simple library for React 16.8+ to share state between components with useState like syntax",
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "main": "src/index.js",
  "files": [
    "src/index.js",
    "src/makeSharedStateHook.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cd example_application; npm install; npm test; cd ..",
    "lint": "eslint src/* --ext .js",
    "lint:fix": "eslint src/* --ext .js --fix",
    "build": "npm run lint:fix && cd example_application && npm install && npm run lint:fix && npm run build && npm run test && cd .."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brentsowers1/make-shared-state-hook.git"
  },
  "author": "Brent Sowers",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/brentsowers1/make-shared-state-hook/issues"
  },
  "homepage": "https://github.com/brentsowers1/make-shared-state-hook#readme",
  "keywords": [
    "react",
    "hooks",
    "state",
    "shared-state"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "globals": "^16.5.0"
  }
}
